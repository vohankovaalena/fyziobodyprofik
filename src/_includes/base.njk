<header class="site-header">
  <div class="site-header__inner">
    <a class="logo" href="/" aria-label="{{ site.name }}: domovská stránka">
      <img class="logo__mark" src="/assets/img/logo-mark.png" alt="" width="187" height="186">
      <img class="logo__text" src="/assets/img/logo-text.png" alt="" width="320" height="138">
    </a>

    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="hlavni-menu">
      <span class="visually-hidden">Otevřít menu</span>
      <svg class="icon-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
      <svg class="icon-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19"/></svg>
    </button>

    <nav class="nav" id="hlavni-menu" aria-label="Hlavní menu">
      <ul class="nav__list">
        {%- for item in nav %}
        {%- if item.children %}
        {#- set uvnitř cyklu v Nunjucks neprosákne ven, proto porovnání přes spojený řetězec adres -#}
        {%- set subActive = page.url != "/" and page.url in (item.children | join(",", "href")) %}
        <li class="nav__item nav__item--sub" data-subnav>
          <button class="nav__link nav__sub-toggle{% if subActive %} is-active{% endif %}" type="button" aria-expanded="false" data-subnav-toggle>
            {{ item.label }}<svg class="nav__caret" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-chevron"/></svg>
          </button>
          <ul class="nav__sub">
            {%- for child in item.children %}
            <li><a class="nav__sublink" href="{{ child.href }}"{% if page.url == child.href %} aria-current="page"{% endif %}>{{ child.label }}</a></li>
            {%- endfor %}
          </ul>
        </li>
        {%- else %}
        <li class="nav__item"><a class="nav__link" href="{{ item.href }}"{% if page.url == item.href %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
        {%- endif %}
        {%- endfor %}
      </ul>
      <div class="nav__cta">
        <a class="btn btn--dark btn--sm" href="{{ site.reservio.cviceni }}" data-reservio="cviceni">Rezervace cvičení</a>
        <a class="btn btn--slate btn--sm" href="{{ site.reservio.terapie }}" data-reservio="terapie">Objednat terapii</a>
      </div>
    </nav>
  </div>
</header>

<main id="obsah">
{{ content | safe -}}
</main>

<footer class="site-footer">
  <div class="wrap site-footer__grid">
    <div>
      <h2 class="site-footer__title">Kde nás najdete</h2>
      <p class="site-footer__lead">{{ site.address.street }},<br>{{ site.address.city }} {{ site.address.zip }}</p>
      <div class="map map--small" data-map data-map-query="{{ site.mapQuery }}">
        <div class="map__consent">
          <p>Kliknutím na tlačítko „Souhlasím“ povolíte Google Maps.</p>
          <button class="btn btn--light btn--xs" type="button" data-map-consent>Souhlasím</button>
        </div>
      </div>
      <p class="site-footer__hours">{{ site.hours[0] }}<br>{{ site.hours[1] }}</p>
    </div>
    <div>
      <h2 class="site-footer__title">Rozcestník</h2>
      <ul class="site-footer__links">
        {%- for item in rozcestnik %}
        <li><a href="{{ item.href }}">{{ item.label }}</a></li>
        {%- endfor %}
      </ul>
    </div>
    <div>
      <h2 class="site-footer__title">Kontakt</h2>
      <p class="site-footer__phone"><a href="tel:{{ site.phoneHref }}">{{ site.phone }}</a></p>
      <p><a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
      <p>IČO: {{ site.ico }}</p>
    </div>
  </div>
  <div class="wrap site-footer__bottom">
    <p>Copyright © <span data-year>2026</span> {{ site.name }}</p>
    <p class="site-footer__credit">Web vytvořilo kreativní studio <a href="https://www.blackmango.cz" target="_blank" rel="noopener">blackmango.cz</a></p>
    <div class="social">
      <a href="{{ site.social.facebook }}" aria-label="Facebook" target="_blank" rel="noopener"><svg class="icon" aria-hidden="true"><use href="#i-facebook"/></svg></a>
      <a href="{{ site.social.instagram }}" aria-label="Instagram" target="_blank" rel="noopener"><svg class="icon" aria-hidden="true"><use href="#i-instagram"/></svg></a>
    </div>
  </div>
</footer>

<script src="/assets/js/main.js" defer></script>
</body>
</html>
